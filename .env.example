# Optional: Gemini model to use when "Google Gemini" is picked (default: gemini-3.5-flash-lite).
# Change this when Google retires the default model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: OpenRouter model to use when "OpenRouter" is picked and the form's model field
# is left blank (default: google/gemini-3.5-flash-lite). Any model that supports
# structured outputs works; see https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# Optional: Set temp directory for large file processing
TMPDIR=/tmp
