# Optional: Gemini model to use when "Google Gemini" is picked (default: gemini-3.5-flash).
# Change this when Google retires the default model.
GEMINI_MODEL=gemini-3.5-flash

# Optional: OpenRouter model to use when "OpenRouter" is picked and the form's model field
# is left blank (default: openrouter/free, which picks a free model for each request).
# Any model that supports structured outputs works; see https://openrouter.ai/models
OPENROUTER_MODEL=openrouter/free

# Optional: Set temp directory for large file processing
TMPDIR=/tmp
